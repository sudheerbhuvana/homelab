# General UID/GID and Timezone
TZ=Asia/Kolkata
PUID=999
PGID=1000
DATA_DIR=/DATA/data

# Custom self-hosted WireGuard (Gluetun custom provider)
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard

# Numeric IP and UDP port of your WireGuard server
WIREGUARD_ENDPOINT_IP=your-server-ip
WIREGUARD_ENDPOINT_PORT=51820

# From your WireGuard client .conf file
WIREGUARD_PUBLIC_KEY=server-public-key
WIREGUARD_PRIVATE_KEY=client-private-key
WIREGUARD_PRESHARED_KEY=preshared-key
WIREGUARD_ADDRESSES=10.8.0.2/32

# Optional: only set if forwarding a torrent port into Gluetun
# FIREWALL_VPN_INPUT_PORTS=6881

# Health check duration
HEALTH_VPN_DURATION_INITIAL=120s

# Static IPs for services on servarrnetwork
SET_IP_GLUETUN=172.30.0.2
SET_IP_SONARR=172.30.0.3
SET_IP_RADARR=172.30.0.4
SET_IP_LIDARR=172.30.0.5
SET_IP_BAZARR=172.30.0.6
SET_IP_SEERR=172.30.0.7
SET_IP_JELLYSTAT_DB=172.30.0.8
SET_IP_JELLYSTAT=172.30.0.9

# Jellystat (uncomment service block in compose.yaml to enable)
JELLYSTAT_POSTGRES_USER=postgres
JELLYSTAT_POSTGRES_PASSWORD=changeme
JELLYSTAT_JWT_SECRET=changeme

